# FARMAI AI Configuration
# Copy this file to .env.local and add your API keys

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================
# Choose your AI provider: openai, google, or anthropic
AI_PROVIDER=openai

# =============================================================================
# OPENAI CONFIGURATION (Recommended)
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Model selection
OPENAI_CHAT_MODEL=gpt-4-turbo-preview
OPENAI_VISION_MODEL=gpt-4-vision-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# GOOGLE AI CONFIGURATION (Alternative)
# =============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Model selection
GOOGLE_CHAT_MODEL=gemini-pro
GOOGLE_VISION_MODEL=gemini-pro-vision

# =============================================================================
# ANTHROPIC CONFIGURATION (Alternative)
# =============================================================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model selection
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# =============================================================================
# AI SERVICE SETTINGS
# =============================================================================
# Maximum tokens for responses
AI_MAX_TOKENS=1000

# Temperature (0.0 - 1.0, lower = more focused)
AI_TEMPERATURE=0.7

# Enable response caching (reduces costs)
AI_ENABLE_CACHE=true

# Cache duration in seconds (default: 1 hour)
AI_CACHE_DURATION=3600

# Rate limiting (requests per minute)
AI_RATE_LIMIT=60

# =============================================================================
# IMAGE PROCESSING
# =============================================================================
# Maximum image size in MB
MAX_IMAGE_SIZE_MB=5

# Image compression quality (0-100)
IMAGE_COMPRESSION_QUALITY=80

# Supported image formats
SUPPORTED_IMAGE_FORMATS=jpg,jpeg,png,webp

# =============================================================================
# VOICE PROCESSING
# =============================================================================
# Enable voice features
ENABLE_VOICE_INPUT=true
ENABLE_VOICE_OUTPUT=true

# Default language for voice
DEFAULT_VOICE_LANGUAGE=en-US

# =============================================================================
# MULTILINGUAL SUPPORT
# =============================================================================
# Supported languages (comma-separated)
SUPPORTED_LANGUAGES=en,sw,ha,yo,am,hi,es,fr,pt

# Default language
DEFAULT_LANGUAGE=en

# =============================================================================
# SECURITY & CONTENT FILTERING
# =============================================================================
# Enable content moderation
ENABLE_CONTENT_MODERATION=true

# Block inappropriate content
BLOCK_INAPPROPRIATE_CONTENT=true

# Log AI interactions (for debugging)
LOG_AI_INTERACTIONS=true

# =============================================================================
# COST OPTIMIZATION
# =============================================================================
# Use cheaper models for simple queries
ENABLE_SMART_MODEL_ROUTING=true

# Fallback to cheaper model if primary fails
ENABLE_MODEL_FALLBACK=true

# Maximum cost per request (USD)
MAX_COST_PER_REQUEST=0.10

# =============================================================================
# DATABASE (Optional - for conversation history)
# =============================================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/farmai

# =============================================================================
# ANALYTICS (Optional)
# =============================================================================
# ENABLE_ANALYTICS=true
# ANALYTICS_API_KEY=your_analytics_key_here

