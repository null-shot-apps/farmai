# FARMAI AI Configuration
# Copy this file to .env.local and add your API keys

# ============================================
# AI PROVIDER CONFIGURATION
# ============================================
# Choose your AI provider: 'openai', 'google', or 'anthropic'
AI_PROVIDER=openai

# ============================================
# OPENAI CONFIGURATION
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Models to use
OPENAI_CHAT_MODEL=gpt-4-turbo-preview
OPENAI_VISION_MODEL=gpt-4-vision-preview

# ============================================
# GOOGLE AI CONFIGURATION
# ============================================
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Models to use
GOOGLE_CHAT_MODEL=gemini-pro
GOOGLE_VISION_MODEL=gemini-pro-vision

# ============================================
# ANTHROPIC CONFIGURATION
# ============================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Models to use
ANTHROPIC_CHAT_MODEL=claude-3-opus-20240229
ANTHROPIC_VISION_MODEL=claude-3-opus-20240229

# ============================================
# AI SETTINGS
# ============================================
# Maximum tokens for responses
AI_MAX_TOKENS=1000

# Temperature (0.0 - 1.0, higher = more creative)
AI_TEMPERATURE=0.7

# Enable/disable features
AI_ENABLE_VOICE=true
AI_ENABLE_IMAGE_ANALYSIS=true
AI_ENABLE_TEXT_CHAT=true

# ============================================
# RATE LIMITING
# ============================================
# Requests per user per hour
AI_RATE_LIMIT_PER_HOUR=100

# ============================================
# CACHING
# ============================================
# Cache AI responses (reduces costs)
AI_ENABLE_CACHE=true
AI_CACHE_TTL_SECONDS=3600

# ============================================
# MULTILINGUAL SETTINGS
# ============================================
# Supported languages (comma-separated)
AI_SUPPORTED_LANGUAGES=en,sw,ha,yo,am,hi,es,fr,pt

# Default language
AI_DEFAULT_LANGUAGE=en

# ============================================
# SECURITY
# ============================================
# Enable content filtering
AI_ENABLE_CONTENT_FILTER=true

# Maximum image upload size (MB)
AI_MAX_IMAGE_SIZE_MB=5

# Allowed image formats
AI_ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp

# ============================================
# LOGGING & MONITORING
# ============================================
# Log AI requests
AI_ENABLE_LOGGING=true

# Log level: 'debug', 'info', 'warn', 'error'
AI_LOG_LEVEL=info

# ============================================
# OFFLINE MODE
# ============================================
# Enable offline fallback responses
AI_ENABLE_OFFLINE_MODE=true

# ============================================
# COST OPTIMIZATION
# ============================================
# Use cheaper models for simple queries
AI_ENABLE_SMART_ROUTING=true

# Compress images before sending to AI
AI_COMPRESS_IMAGES=true

# Image compression quality (0-100)
AI_IMAGE_QUALITY=80

